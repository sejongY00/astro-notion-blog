---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants.ts'
import { getDatabase } from '../lib/notion/client.ts'
import { getNavLink, getStaticFilePath, getTagLink } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import '@fontsource/bricolage-grotesque/400.css'
import '@fontsource/bricolage-grotesque/500.css'
import '@fontsource/bricolage-grotesque/700.css'
import '@fontsource/public-sans/400.css'
import '@fontsource/public-sans/700.css'
import '../styles/slate.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SearchModal from '../components/SearchModal.astro'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const database = await getDatabase()

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/default-og-image.png'),
  Astro.site
)

const navItems = [
  { label: '홈', href: getNavLink('/'), current: path === '/' },
  { label: '개발', href: getTagLink('개발'), current: path === '/posts/tag/개발' },
  { label: '서버', href: getTagLink('서버'), current: path === '/posts/tag/서버' },
  { label: '소개', href: getNavLink('/about'), current: path === '/about' },
]
---

<!DOCTYPE html>
<html lang="ko" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={database.Title} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={getNavLink('/')}>{database.Title}</a>
        <nav class="main-nav">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class:list={{ current: item.current }}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button class="open-search-modal nav-search" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                검색
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot name="main" />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <a class="footer-logo" href={getNavLink('/')}>{database.Title}</a>
        <p class="footer-desc">{database.Description}</p>
      </div>
      <div class="footer-bottom">
        Notion + <a href="https://astro.build/">Astro</a>로 만들었습니다
      </div>
    </footer>

    <a href="#" class="back-to-top" aria-label="맨 위로">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg>
    </a>

    <SearchModal />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
    <script>
      const toTop = document.querySelector('.back-to-top')
      const toggle = () => toTop?.classList.toggle('visible', window.scrollY > 400)
      window.addEventListener('scroll', toggle, { passive: true })
      toggle()
      toTop?.addEventListener('click', (e) => {
        e.preventDefault()
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })

      // Cmd+K / Ctrl+K로 검색 열기
      document.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)) {
          e.preventDefault()
          document.querySelector<HTMLButtonElement>('.open-search-modal')?.click()
        }
      })
    </script>
  </body>
</html>

<style>
  .site-header {
    padding: 40px 0 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 54px;
  }
  .logo {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.3px;
  }
  .main-nav ul {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .main-nav a,
  .nav-search {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-heading);
    font-size: 15px;
    color: var(--muted);
    cursor: pointer;
  }
  .main-nav a:hover,
  .nav-search:hover,
  .main-nav a.current {
    color: #151515;
  }
  .main-nav a.current {
    font-weight: 700;
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    margin-top: 120px;
    padding: 50px 0 0;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 700;
    color: var(--heading);
  }
  .footer-desc {
    margin: 8px 0 40px;
    font-size: 15px;
    color: var(--muted);
  }
  .footer-bottom {
    padding: 22px 20px 30px;
    border-top: 1px solid var(--line);
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--muted);
  }
  .footer-bottom a {
    color: var(--heading);
    font-weight: 700;
    text-decoration: underline;
  }

  .back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #151515;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 700px) {
    .site-header {
      padding-top: 24px;
    }
    .header-inner {
      flex-direction: column;
      gap: 14px;
    }
    .logo {
      font-size: 26px;
    }
    .main-nav ul {
      gap: 18px;
    }
  }
</style>
