---
import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import {
  getAllPosts,
  getPostsByTagAndPage,
  getAllTags,
  getNumberOfPagesByTag,
} from '../../../../../lib/notion/client.ts'
import Layout from '../../../../../layouts/Layout.astro'
import NoContents from '../../../../../components/NoContents.astro'
import PostCard from '../../../../../components/PostCard.astro'
import Pagination from '../../../../../components/Pagination.astro'
import ListHeader from '../../../../../components/ListHeader.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()

  let params = []

  await Promise.all(
    allTags.map((tag: SelectProperty) => {
      return getNumberOfPagesByTag(tag.name).then((numberOfPages: number) => {
        for (let i = 2; i <= numberOfPages; i++) {
          params.push({ params: { tag: tag.name, page: i.toString() } })
        }
      })
    })
  )

  return params
}

const { tag, page } = Astro.params

const [posts, allPosts, numberOfPages] = await Promise.all([
  getPostsByTagAndPage(tag, parseInt(page, 10)),
  getAllPosts(),
  getNumberOfPagesByTag(tag),
])
const count = allPosts.filter((p) => p.Tags.some((t) => t.name === tag)).length
---

<Layout title={`${tag} ${page}쪽`} path={`/posts/tag/${tag}/page/${page}`}>
  <div slot="main">
    <ListHeader label="태그" title={tag} count={count} />
    <section class="wrap">
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          posts.map((post) => <PostCard post={post} />)
        )
      }
      <Pagination tag={tag} currentPage={parseInt(page, 10)} numberOfPages={numberOfPages} />
    </section>
  </div>
</Layout>
