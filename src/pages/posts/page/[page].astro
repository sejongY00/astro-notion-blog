---
import { getPostsByPage, getNumberOfPages } from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import NoContents from '../../../components/NoContents.astro'
import PostCard from '../../../components/PostCard.astro'
import Pagination from '../../../components/Pagination.astro'
import ListHeader from '../../../components/ListHeader.astro'

export async function getStaticPaths() {
  const numberOfPages = await getNumberOfPages()

  let params = []
  for (let i = 2; i <= numberOfPages; i++) {
    params.push({ params: { page: i.toString() } })
  }
  return params
}

const { page } = Astro.params

const [posts, numberOfPages] = await Promise.all([
  getPostsByPage(parseInt(page, 10)),
  getNumberOfPages(),
])
---

<Layout title={`${page}쪽`} path={`/posts/page/${page}`}>
  <div slot="main">
    <ListHeader label="전체 글" title={`${numberOfPages}쪽 중 ${page}쪽`} />
    <section class="wrap">
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          posts.map((post) => <PostCard post={post} />)
        )
      }
      <Pagination currentPage={parseInt(page, 10)} numberOfPages={numberOfPages} />
    </section>
  </div>
</Layout>
