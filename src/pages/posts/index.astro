---
import { getAllPosts } from '../../lib/notion/client.ts'
import Layout from '../../layouts/Layout.astro'
import NoContents from '../../components/NoContents.astro'
import PostCard from '../../components/PostCard.astro'
import ListHeader from '../../components/ListHeader.astro'

// 메인은 최근 3편만 보여 주므로, 모든 글은 여기서 한 번에 본다.
const posts = await getAllPosts()
---

<Layout title="전체 글" path="/posts">
  <div slot="main">
    <ListHeader label="전체 글" title="모든 글" count={posts.length} />
    <section class="wrap">
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          posts.map((post) => <PostCard post={post} />)
        )
      }
    </section>
  </div>
</Layout>
