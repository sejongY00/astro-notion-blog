---
import { NUMBER_OF_POSTS_PER_PAGE } from '../server-constants.ts'
import { getPosts, getNumberOfPages } from '../lib/notion/client.ts'
import Layout from '../layouts/Layout.astro'
import NoContents from '../components/NoContents.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'

const [posts, numberOfPages] = await Promise.all([
  getPosts(NUMBER_OF_POSTS_PER_PAGE),
  getNumberOfPages(),
])
---

<Layout>
  <div slot="main">
    <section class="hero wrap-small">
      <h1>Sejong Yoo</h1>
      <p>
        네트워크 엔지니어 출신 소프트웨어 엔지니어. 직접 운영하는 서버 위에서
        서비스를 만들고 고치며, 그 과정을 기록합니다.
      </p>
      <div class="social">
        <a href="https://github.com/sejongY00" target="_blank" rel="me noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          GitHub
        </a>
        <a href="https://git.sejong.dev/ysj7705" target="_blank" rel="me noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
          Gitea
        </a>
      </div>
    </section>

    <section class="wrap">
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          posts.map((post) => <PostCard post={post} />)
        )
      }
      <Pagination currentPage={1} numberOfPages={numberOfPages} />
    </section>
  </div>
</Layout>

<style>
  .hero {
    padding: 70px 20px 110px;
    text-align: center;
  }
  .hero h1 {
    margin: 0 0 14px;
    font-size: 50px;
    line-height: 1.2;
    font-weight: 700;
  }
  .hero p {
    margin: 0 auto 18px;
    font-size: 16px;
    line-height: 1.9;
    color: var(--muted);
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 22px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--text);
  }
  .social a:hover {
    color: var(--heading);
  }
  @media (max-width: 700px) {
    .hero {
      padding: 50px 20px 70px;
    }
    .hero h1 {
      font-size: 38px;
    }
  }
</style>
