---
import { getPageLink } from '../lib/blog-helpers.ts'

export interface Props {
  currentPage: number
  numberOfPages: number
  tag?: string
}

const { currentPage, numberOfPages, tag = '' } = Astro.props
---

{
  numberOfPages > 1 && (
    <nav class="pagination">
      {currentPage > 1 ? (
        <a href={getPageLink(currentPage - 1, tag)}>최신 글</a>
      ) : (
        <span />
      )}
      <span class="page-number">
        {numberOfPages}쪽 중 {currentPage}쪽
      </span>
      {currentPage < numberOfPages ? (
        <a href={getPageLink(currentPage + 1, tag)}>이전 글</a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 20px 0 0;
    font-family: var(--font-heading);
    font-size: 14px;
  }
  .pagination a {
    justify-self: start;
    padding: 8px 18px;
    border-radius: 6px;
    background: #151515;
    color: #fff;
    font-weight: 500;
  }
  .pagination a:last-child {
    justify-self: end;
  }
  .page-number {
    color: var(--muted);
  }
</style>
