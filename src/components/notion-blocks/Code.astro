---
import Prism from 'prismjs'
import 'prismjs/components/prism-bash'
import 'prismjs/components/prism-css'
import 'prismjs/components/prism-diff'
import 'prismjs/components/prism-docker'
import 'prismjs/components/prism-elixir'
import 'prismjs/components/prism-go'
import 'prismjs/components/prism-hcl'
import 'prismjs/components/prism-java'
import 'prismjs/components/prism-json'
import 'prismjs/components/prism-python'
import 'prismjs/components/prism-ruby'
import 'prismjs/components/prism-sql'
import 'prismjs/components/prism-typescript'
import 'prismjs/components/prism-yaml'
import * as interfaces from '../../lib/interfaces'
import Caption from './Caption.astro'

export interface Props {
  block: interfaces.Block
}

const { block } = Astro.props

const code = block.Code.RichTexts.map(
  (richText: interfaces.RichText) => richText.Text.Content
).join('')
const language = block.Code.Language.toLowerCase()

// Notion 언어 이름 → Prism 문법 이름. 없는 언어는 색 없이 그대로 보여준다.
const prismAlias: Record<string, string> = {
  shell: 'bash',
  'plain text': '',
  dockerfile: 'docker',
}
const prismName = language in prismAlias ? prismAlias[language] : language
const grammer = prismName ? Prism.languages[prismName] : undefined
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const highlighted = grammer
  ? Prism.highlight(code, grammer, prismName)
  : escapeHtml(code)

// 코드 블록 오른쪽 위에 보여줄 언어 이름
const languageLabels: Record<string, string> = {
  'plain text': 'Plain text',
  bash: 'Bash',
  shell: 'Shell',
  javascript: 'JavaScript',
  typescript: 'TypeScript',
  json: 'JSON',
  yaml: 'YAML',
  docker: 'Dockerfile',
  dockerfile: 'Dockerfile',
  python: 'Python',
  go: 'Go',
  html: 'HTML',
  css: 'CSS',
  sql: 'SQL',
  markdown: 'Markdown',
}
const languageLabel =
  languageLabels[language] ||
  language.charAt(0).toUpperCase() + language.slice(1)

const lineCount = code.replace(/\n$/, '').split('\n').length
const lineNumbers = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n')
---

<div class="code">
  <div>
    {
      /* prettier-ignore */
      language === 'mermaid' ? (
        <pre class="mermaid">{code}</pre>
      ) : (
        <>
          <div class="toolbar">
            <span class="language">{languageLabel}</span>
            <button class="copy" data-code={code} data-done-text="복사됨">
              복사
            </button>
          </div>
          <div class="body">
            <pre class="line-numbers" aria-hidden="true">{lineNumbers}</pre>
            <pre><code set:html={highlighted} /></pre>
          </div>
        </>
      )
    }
  </div>
  <Caption richTexts={block.Code.Caption} />
</div>

<script>
  import mermaid from 'mermaid'
  mermaid.initialize({ startOnLoad: true, theme: 'neutral' })
</script>

<script>
  document.querySelectorAll('button.copy').forEach((button) => {
    button.addEventListener('click', (ev) => {
      navigator.clipboard
        .writeText(ev.target.getAttribute('data-code'))
        .then(() => {
          const originalText = ev.target.innerText

          ev.target.innerText = ev.target.getAttribute('data-done-text')

          setTimeout(() => {
            ev.target.innerText = originalText
          }, 3000)
        })
    })
  })
</script>

<style>
  .code {
    display: block;
    width: 100%;
    margin: 8px 0 24px;
  }
  .code > div {
    position: relative;
    background: #2d2d2d;
    border-radius: 10px;
  }
  .toolbar {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .language {
    font-family: var(--font-heading);
    font-size: 12px;
    color: #999;
  }
  .code button.copy {
    display: block;
    padding: 2px 8px;
    border: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.12);
    color: #ccc;
    font-size: 12px;
    line-height: 1.6;
    cursor: pointer;
  }
  .body {
    display: flex;
  }
  .code pre {
    margin: 0;
    padding: 16px 18px;
    color: #ccc;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    white-space: pre;
  }
  .code pre.line-numbers {
    flex: none;
    padding-right: 12px;
    border-right: 1px solid #555;
    color: #777;
    text-align: right;
    user-select: none;
  }
  .code pre:not(.line-numbers) {
    flex: 1;
    min-width: 0;
    padding-right: 150px;
    overflow-x: auto;
    &::-webkit-scrollbar {
      height: 10px;
    }
    &::-webkit-scrollbar-thumb {
      background: #555;
    }
    &::-webkit-scrollbar-track {
      background: #2d2d2d;
    }
  }
  .code pre.mermaid {
    padding: 2rem;
    background: #fff;
    border-radius: 10px;
  }
  .code pre code {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none !important;
    color: inherit;
    font-size: inherit;
  }
</style>
