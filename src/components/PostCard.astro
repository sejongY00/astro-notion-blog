---
import type { Post } from '../lib/interfaces.ts'
import { filePath, getPostLink } from '../lib/blog-helpers.ts'
import PostMeta from './PostMeta.astro'

export interface Props {
  post: Post
}

const { post } = Astro.props

let image = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  image = import.meta.env.DEV
    ? post.FeaturedImage.Url
    : filePath(new URL(post.FeaturedImage.Url))
}
const link = getPostLink(post.Slug)
---

<article class="card">
  {
    image && (
      <a class="thumb" href={link} aria-label={post.Title}>
        <img src={image} alt="" loading="lazy" />
      </a>
    )
  }
  <div class="info">
    <h2 class="title"><a href={link}>{post.Title}</a></h2>
    {post.Excerpt && <p class="excerpt">{post.Excerpt}</p>}
    <PostMeta post={post} />
  </div>
</article>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 70px;
    margin: 0 0 80px;
  }
  .thumb {
    flex: 0 0 425px;
    height: 385px;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: 0 3px 5px rgba(0, 0, 0, 0.2);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .thumb:hover img {
    transform: scale(1.04);
  }
  .info {
    flex: 1;
    min-width: 0;
  }
  .title {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--heading);
  }
  .title a {
    color: inherit;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s ease;
  }
  .title a:hover {
    background-size: 100% 2px;
  }
  .excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.9;
    color: var(--text);
  }
  @media (max-width: 900px) {
    .card {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      margin-bottom: 60px;
    }
    .thumb {
      flex: none;
      height: auto;
      aspect-ratio: 425 / 385;
    }
    .title {
      font-size: 26px;
    }
  }
</style>
