---
---

<div class="search-modal-container" hidden>
  <div class="overlay"></div>

  <div class="search-modal" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="search-prompt">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
      <input type="text" placeholder="글 제목이나 내용으로 검색" autocomplete="off" spellcheck="false" />
      <button class="search-close" type="button" aria-label="닫기">ESC</button>
    </div>
    <div class="search-result">
      <p class="search-heading"></p>
      <ul></ul>
      <p class="search-empty" hidden>검색 결과가 없어요.</p>
    </div>
  </div>
</div>

<style>
  div.search-modal-container[hidden] {
    display: none;
  }

  div.overlay {
    z-index: 99;
    position: fixed;
    inset: 0;
    background: rgba(28, 25, 23, 0.35);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  div.search-modal {
    z-index: 100;
    position: fixed;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(640px, calc(100% - 32px));
    display: flex;
    flex-direction: column;
    max-height: 72vh;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.06);
    animation: search-in 0.15s ease-out;
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
  }
  @media (max-width: 640px) {
    div.search-modal {
      top: 16px;
      max-height: calc(100vh - 32px);
    }
  }

  div.search-prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  div.search-prompt input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: var(--heading);
    font-family: var(--font-body);
    font-size: 17px;
  }
  div.search-prompt input::placeholder {
    color: #a1a1aa;
  }
  button.search-close {
    flex: none;
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.6;
    cursor: pointer;
  }

  div.search-result {
    overflow-y: auto;
    padding: 6px 8px 10px;
  }
  p.search-heading,
  p.search-empty {
    margin: 8px 10px 4px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  p.search-empty {
    margin: 18px 10px;
    text-align: center;
    font-size: 15px;
  }
  div.search-result ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  div.search-result ul > :global(li > a) {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    transition: background-color 0.1s;
  }
  div.search-result ul > :global(li.selected > a) {
    background: #f4f4f5;
  }

  div.search-result :global(.search-result-title) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: var(--heading);
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }
  div.search-result :global(.search-result-title time) {
    flex: none;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
  }
  div.search-result :global(.search-result-description) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 2px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }
  div.search-result :global(mark) {
    padding: 0 1px;
    border-radius: 2px;
    background: rgba(23, 91, 235, 0.12);
    color: var(--link);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.search-modal-container')
    const input = container.querySelector('.search-prompt input')
    const ul = container.querySelector('.search-result ul')
    const heading = container.querySelector('.search-heading')
    const empty = container.querySelector('.search-empty')
    let feedItems = []
    let fetched = false

    const isOpen = () => !container.hidden

    async function openModal() {
      container.hidden = false
      document.body.style.overflow = 'hidden'
      input.focus()
      input.select()
      if (!fetched) {
        await fetchRSS()
      }
      searchAndRender()
    }

    function closeModal() {
      container.hidden = true
      document.body.style.overflow = ''
    }

    function handleKeydown(event) {
      if (!isOpen() || event.isComposing) return
      if (event.key === 'Enter') {
        event.preventDefault()
        ul.querySelector('li.selected a')?.click()
      } else if (event.key === 'Escape') {
        closeModal()
      } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
        event.preventDefault()
        move(event.key === 'ArrowUp' ? -1 : 1)
      }
    }

    function move(step) {
      const items = Array.from(ul.children)
      if (items.length === 0) return
      const current = items.findIndex((li) => li.classList.contains('selected'))
      const next = (current + step + items.length) % items.length
      items[current]?.classList.remove('selected')
      items[next].classList.add('selected')
      items[next].scrollIntoView({ block: 'nearest' })
    }

    function searchAndRender() {
      const query = input.value.trim()
      const results = query ? search(query) : feedItems
      heading.textContent = query ? `검색 결과 ${results.length}개` : '최근 글'
      heading.hidden = results.length === 0
      empty.hidden = results.length !== 0
      renderResults(results, query)
      ul.firstElementChild?.classList.add('selected')
    }

    function search(query) {
      const q = query.toLowerCase()
      return feedItems.filter(
        (item) =>
          item.title.toLowerCase().includes(q) ||
          item.description.toLowerCase().includes(q)
      )
    }

    // 검색어 부분을 <mark>로 감싼다. textContent로만 넣어 HTML이 섞이지 않게 한다.
    function highlight(element, text, query) {
      if (!query) {
        element.append(text)
        return
      }
      const lower = text.toLowerCase()
      const q = query.toLowerCase()
      let from = 0
      let at
      while ((at = lower.indexOf(q, from)) !== -1) {
        element.append(text.slice(from, at))
        const mark = document.createElement('mark')
        mark.textContent = text.slice(at, at + q.length)
        element.append(mark)
        from = at + q.length
      }
      element.append(text.slice(from))
    }

    function renderResults(results, query) {
      ul.replaceChildren()
      results.forEach((item) => {
        const li = document.createElement('li')
        const a = document.createElement('a')
        const title = document.createElement('div')
        const titleText = document.createElement('span')
        const description = document.createElement('div')

        title.className = 'search-result-title'
        highlight(titleText, item.title, query)
        title.append(titleText)
        if (item.date) {
          const time = document.createElement('time')
          time.textContent = item.date
          title.append(time)
        }
        description.className = 'search-result-description'
        highlight(description, item.description, query)
        a.href = item.link

        li.addEventListener('mousemove', () => {
          if (li.classList.contains('selected')) return
          ul.querySelector('li.selected')?.classList.remove('selected')
          li.classList.add('selected')
        })

        a.append(title, description)
        li.append(a)
        ul.append(li)
      })
    }

    async function fetchRSS() {
      const res = await fetch(`${location.origin}/feed`)
      if (res.status !== 200) {
        throw new Error(`Failed to fetch RSS feed: ${res.status}`)
      }
      const xml = new DOMParser().parseFromString(await res.text(), 'text/xml')
      const text = (item, tag) =>
        item.getElementsByTagName(tag)[0]?.textContent?.trim() ?? ''

      feedItems = Array.from(xml.getElementsByTagName('item')).map((item) => {
        const pubDate = new Date(text(item, 'pubDate'))
        return {
          title: text(item, 'title'),
          link: text(item, 'link'),
          description: text(item, 'description'),
          date: isNaN(pubDate.getTime())
            ? ''
            : pubDate.toLocaleDateString('ko-KR', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              }),
        }
      })
      fetched = true
    }

    document.querySelectorAll('.open-search-modal').forEach((element) => {
      element.addEventListener('click', openModal)
    })
    container.querySelector('.overlay').addEventListener('click', closeModal)
    container.querySelector('.search-close').addEventListener('click', closeModal)
    // keydown이 아니라 input 이벤트로 검색해야 한글 조합 중에도 결과가 바뀐다.
    input.addEventListener('input', searchAndRender)
    document.addEventListener('keydown', handleKeydown)
  })
</script>
